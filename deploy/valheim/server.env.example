# Copied once by install.sh to /srv/valheim/server.env on the VPS (not in git).
# After editing: docker compose -f deploy/valheim/compose.yml up -d — compose
# recreates the container with the new values.

# The name of the world's FOLDER in /srv/valheim/saves/worlds_local, character for
# character: it is the world's identity. Note the "w" — AstwardWorld, not Astvard.
# A wrong name would make the game quietly create a new empty world; server.sh
# refuses to start instead.
WORLD_NAME=AstwardWorld

SERVER_NAME=Astvard
SAVE_INTERVAL=900

# yes — start through BepInEx, loading /srv/valheim/server/BepInEx/plugins
# (Jotunn and AstvardServerMod); no — vanilla. When the mod is on, its DLL here
# and in the players' clients has to be the same file, byte for byte.
BEPINEX=no
