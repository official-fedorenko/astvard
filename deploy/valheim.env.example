# Скопировать на VPS как /srv/valheim/server.env (в git не лежит).
#
# WORLD_NAME — имя ПАПКИ мира, символ в символ. Оно и есть личность мира:
# ошибёшься — сервер не упадёт, а молча создаст пустой мир. Посмотреть точное имя:
#   ls "C:\Games\valheim-servers\astvard\worlds_local"
# В CLAUDE.md записано AstwardWorld — через "w", не "v". Сверь перед запуском.
WORLD_NAME=AstwardWorld
SERVER_NAME=Astvard
SERVER_PORT=2456
SAVE_INTERVAL=900
