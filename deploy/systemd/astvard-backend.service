[Unit]
Description=Astvard portal
Documentation=https://github.com/official-fedorenko/astvard
After=network-online.target
Wants=network-online.target

# The panel exits on purpose on a broken configuration. Without a limit systemd
# would restart that forever and bury the reason in the journal.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=astvard
Group=astvard
WorkingDirectory=/srv/astvard

# The panel loads .env itself, with dotenv, from its working directory — hence no
# --env-file and no EnvironmentFile: one reader, Node's, in every environment.
ExecStart=/usr/bin/node /srv/astvard/server.js

Restart=on-failure
RestartSec=5s

# Writable: its own directory, for uploads, and the game server's save folder —
# that is where permittedlist.txt and adminlist.txt live, and the panel writes them
# so that granting access or in-game admin reaches the server by itself. The leading
# dash keeps the unit starting on a machine that has no game server at all.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/astvard -/srv/valheim/saves
# The Valheim server's own files: its log is how a -public 0 server's status is
# known, and the mod's config holds the runes and the shared builds the site
# shows. Somebody else's directory, so read-only and nothing more.
ReadOnlyPaths=/srv/valheim/logs /srv/valheim/server/BepInEx/config
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=astvard-backend

[Install]
WantedBy=multi-user.target
